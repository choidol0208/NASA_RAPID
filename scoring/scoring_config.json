    "diluent": {
      "same": 1.0,
      "other_inert": 0.5,
      "none": 0.0,
      "molar_cp_298K_kJ_per_kmolK": {
        "CO2": 37.198,
        "N2": 29.071,
        "He": 20.786
      },
      "cp_ratio_exponent": 2,
      "why": "An inert diluent acts mainly thermally (Turns 2012, ch. 8), so two different inerts are compared by molar heat capacity: similarity = (smaller cp / larger cp) ^ exponent, the best match over the configuration's diluents. cp at 298 K: CO2 and N2 from Turns 2012, Appendix A (Tables A.2, A.7, JANAF-based); He as an ideal monatomic gas, 5R/2. The exponent 2 is the team's choice: it keeps the average near the earlier flat 0.5 (CO2-N2 0.61, N2-He 0.51, CO2-He 0.31). Helium's high thermal diffusivity is not captured. other_inert is used for a gas with no cp here. Version 1.1.0 (2026-11-14)."
    },
    "unknown_cap_dims": [
      "o2",
      "fuel"
    ],
    "_unknown_cap_why": "For gate dimensions an unknown catalog value never scores above the best known match in the catalog for the same query, so missing data cannot outrank measured evidence."
  },
  "gate": {
    "dimensions": [
      "fuel",
      "o2"
    ],
    "min_similarity": 0.2,
    "factor": 0.5,
    "mode": "ramp",
    "why": "Combustion is not compensatory: a wrong fuel phase or a far-off O2 cannot be offset by other matches. The gate ramps linearly from 0.5 (similarity 0) to 1.0 (similarity >= 0.2) to avoid a cliff; it also applies to unknown values after capping."
  },
