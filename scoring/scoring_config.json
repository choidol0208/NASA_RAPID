{
  "_about": {
    "what": "Scoring rules for ranking PSI test configurations against a user scenario. Read by scoring/scorer.py; the dashboard can read the same file (e.g., to draw weight sliders).",
    "status": "Team proposal (2026-11-14), not NASA guidance. Weights and scales are to be reviewed by the team; change them here only, never in code.",
    "generated_by": "AI-assisted (Claude), reviewed: no",
    "formula": "score = 100 * M * G * sum_i(w_i * S_i) over active dimensions; weights renormalized to sum 1 over active dimensions"
  },
  "version": "1.0.0",
  "default_profile": "prevention",
  "profiles": {
    "prevention": {
      "label_en": "Material flammability (prevention)",
      "label_ko": "재료 가연성 (예방)",
      "weights": {
        "o2": 0.25,
        "pressure": 0.1,
        "flow": 0.2,
        "fuel": 0.25,
        "geometry": 0.1,
        "role": 0.1,
        "diluent": 0.0
      },
      "rationale": "Microgravity solid flammability is mapped on an oxygen-concentration vs flow-speed plane (U-shaped boundary), so O2 and flow carry 0.45; fuel type next; pressure and geometry modify."
    },
    "detection": {
      "label_en": "Smoke and fire detection",
      "label_ko": "감지",
      "weights": {
        "o2": 0.1,
        "pressure": 0.05,
        "flow": 0.1,
        "fuel": 0.3,
        "geometry": 0.05,
        "role": 0.4,
        "diluent": 0.0
      },
      "rationale": "Smoke amount and particle size depend mostly on the material and on whether the study measured smoke; atmosphere is secondary."
    },
    "suppression": {
      "label_en": "Suppression and extinguishment",
      "label_ko": "진압",
      "weights": {
        "o2": 0.15,
        "pressure": 0.05,
        "flow": 0.1,
        "fuel": 0.2,
        "geometry": 0.05,
        "role": 0.3,
        "diluent": 0.15
      },
      "rationale": "Whether the study tested extinguishment and with which diluent matters most; post-dilution O2 still governs extinction."
    }
  },
  "similarity": {
    "unknown_value": 0.5,
    "o2": {
      "above_scale_pct": 5.0,
      "below_scale_pct": 10.0,
      "why": "Asymmetric: a user O2 above the tested max means the real fire may be worse than tested (non-conservative), so it decays faster."
    },
    "pressure": {
      "sigma_ln": 0.693147,
      "why": "Log distance: kinetics and diffusivity scale with pressure ratios. A factor of 2 gives 0.61."
    },
    "flow_speed": {
      "sigma_ln": 0.693147,
      "offset_cms": 1.0,
      "why": "Log distance on (v + 1 cm/s) so quiescent (0) is handled; quiescent vs forced flow are different extinction regimes."
    },
    "flow_config_matrix": {
      "_rows_are_user_state": true,
      "quiescent": {
        "quiescent": 1.0,
        "opposed": 0.5,
        "concurrent": 0.5,
