  "similarity": {
    "unknown_value": 0.5,
    "o2": {
      "metric": "log_ratio",
      "above_scale_ln": 0.213574,
      "below_scale_ln": 0.646627,
      "why": "Asymmetric: a user O2 above the tested max means the real fire may be worse than tested (non-conservative), so it decays faster. Distance is the log of the O2 ratio, because the effect of oxygen on a flame goes with ratios of its mole fraction: a diffusion flame's stoichiometric ratio scales with 1/X_O2 (Turns 2012, ch. 9; scoring/MODEL_BASIS.md). The scales are ln(26/21) above and ln(21/11) below, so near air they equal the earlier 5 and 10 percentage points; 15 against 21% is now a larger gap than 30 against 36%. Version 1.1.0 (2026-11-14)."
    },
    "pressure": {
      "sigma_ln": 0.693147,
      "why": "Log distance: kinetics and diffusivity scale with pressure ratios. A factor of 2 gives 0.61."
    },
    "flow_speed": {
      "sigma_ln": 0.693147,
      "offset_cms": 1.0,
      "why": "Log distance on (v + 1 cm/s) so quiescent (0) is handled; quiescent vs forced flow are different extinction regimes."
    },
