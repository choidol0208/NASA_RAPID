   "meaning": "Igniter on-time"
  },
  "hot_ignition": {
   "kind": "outcome",
   "unit": "yes | no | flash",
   "meaning": "Whether a hot flame ignited"
  },
  "burn_time_s": {
   "kind": "outcome",
   "unit": "s",
   "meaning": "Burn time"
