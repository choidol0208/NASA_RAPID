  "burning_rate_mm2_s": {
   "kind": "outcome",
   "unit": "mm2/s",
   "meaning": "Droplet burning rate constant"
  },
  "flow_event": {
   "kind": "outcome",
   "unit": "extinction | blowoff | no_ignition | not_sustained",
   "meaning": "Event noted next to the flow settings (BASS-II): \"ext\", \"blowoff\", \"no ign\", \"would not stay lit\""
  },
  "burn_length_cm": {
   "kind": "outcome",
   "unit": "cm",
   "meaning": "Length burned in microgravity"
  },
  "spread_rate_mm_s": {
   "kind": "outcome",
   "unit": "mm/s",
   "meaning": "Flame spread rate in microgravity"
  },
  "o2_final_pct": {
   "kind": "outcome",
   "unit": "% by volume",
   "meaning": "Oxygen concentration after the test"
  },
  "co2_initial_pct": {
   "kind": "outcome",
   "unit": "% by volume",
   "meaning": "CO2 before the test"
  },
  "co2_final_pct": {
   "kind": "outcome",
   "unit": "% by volume",
   "meaning": "CO2 after the test"
  },
  "co_initial_ppm": {
   "kind": "outcome",
   "unit": "ppm",
   "meaning": "CO before the test"
  },
  "co_final_ppm": {
   "kind": "outcome",
   "unit": "ppm",
   "meaning": "CO after the test"
  },
  "mass_loss_rate_mg_min": {
   "kind": "outcome",
   "unit": "mg/min",
   "meaning": "Sample mass loss rate"
  }
 },
 "derived": {
  "o2_consumed_pct_points": {
   "unit": "percentage points",
   "formula": "o2_pct - o2_final_pct",
   "skip_if": [
    {
     "expr": "o2_final_pct > o2_pct + 0.5",
     "flag": "final_o2_above_initial_in_source"
    },
    {
     "expr": "o2_final_pct < 5",
     "flag": "final_o2_implausibly_low_in_source"
    }
   ]
  },
  "co2_produced_pct_points": {
   "unit": "percentage points",
   "formula": "co2_final_pct - co2_initial_pct",
   "flag_if": [
    {
     "expr": "value < 0",
     "flag": "final_below_initial"
    }
   ]
  },
  "co_produced_ppm": {
   "unit": "ppm",
   "formula": "co_final_ppm - co_initial_ppm",
   "flag_if": [
    {
     "expr": "value < 0",
     "flag": "final_below_initial"
    }
   ]
  },
  "co_to_co2_molar_ratio": {
   "unit": "mol/mol",
   "formula": "co_produced_ppm * 1e-4 / co2_produced_pct_points",
   "skip_if": [
    {
     "expr": "co_produced_ppm <= 0",
     "flag": null
    },
    {
     "expr": "co2_produced_pct_points < 0.05",
     "flag": null
    }
   ]
  },
  "extinction_to_initial_diameter_ratio": {
   "unit": "ratio",
   "formula": "extinction_diameter_mm / initial_diameter_mm",
   "flag_if": [
    {
     "expr": "value > 1",
     "flag": "extinction_diameter_larger_than_initial"
    }
   ]
  }
 },
 "ranges": {
  "_note": "A value outside its range is emptied and flagged '<variable>:out_of_range'.",
