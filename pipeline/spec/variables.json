{
 "_meta": {
  "generated_by": "AI-generated draft (Claude Code), 2026-11-14. Not human-reviewed.",
  "purpose": "The standard vocabulary. Every source column is mapped onto one of these names and units, so tests from different experiments can sit in one table.",
  "derived_note": "Derived values are computed by the engine from 'formula', in the order listed. A formula is skipped when any input is empty or a 'skip_if' expression is true."
 },
 "variables": {
  "fuel_material": {
   "kind": "condition",
   "unit": "",
   "meaning": "Material or fuel burned"
  },
  "material_id": {
   "kind": "condition",
   "unit": "id in materials.json",
   "meaning": "Standard material id; groups the same material across tables"
  },
  "fuel_phase": {
   "kind": "condition",
   "unit": "solid | liquid | gas | aerosol",
   "meaning": "Phase of the fuel as tested"
  },
  "sample_geometry": {
   "kind": "condition",
   "unit": "",
   "meaning": "Shape of the sample or burner"
  },
  "sample_thickness_mm": {
   "kind": "condition",
   "unit": "mm",
   "meaning": "Sample thickness"
  },
  "sample_width_cm": {
   "kind": "condition",
   "unit": "cm",
   "meaning": "Sample width"
  },
  "sample_length_cm": {
   "kind": "condition",
   "unit": "cm",
   "meaning": "Sample length"
  },
  "rod_diameter_mm": {
   "kind": "condition",
   "unit": "mm",
   "meaning": "Rod diameter"
  },
  "initial_diameter_mm": {
   "kind": "condition",
   "unit": "mm",
   "meaning": "Droplet diameter at ignition"
  },
  "o2_pct": {
   "kind": "condition",
   "unit": "% by volume",
   "meaning": "Oxygen concentration at the start of the test"
  },
  "o2_basis": {
   "kind": "condition",
   "unit": "ambient | oxidizer_stream",
   "meaning": "Whether o2_pct is the surrounding atmosphere or the gas issuing from the burner"
  },
  "co2_pct": {
   "kind": "condition",
   "unit": "% by volume",
   "meaning": "Carbon dioxide added to the atmosphere before the test"
  },
  "he_pct": {
   "kind": "condition",
   "unit": "% by volume",
   "meaning": "Helium added to the atmosphere before the test"
  },
  "pressure_kpa": {
   "kind": "condition",
   "unit": "kPa",
   "meaning": "Ambient pressure"
  },
  "flow_cms": {
   "kind": "condition",
   "unit": "cm/s",
   "meaning": "Imposed flow speed at the start of the test"
  },
  "flow_min_cms": {
   "kind": "condition",
   "unit": "cm/s",
   "meaning": "Lowest flow speed set during the test"
  },
  "flow_direction": {
   "kind": "condition",
   "unit": "concurrent | opposed",
   "meaning": "Flame spread direction relative to the flow"
  },
  "gravity_level": {
   "kind": "condition",
   "unit": "microgravity | 1g | lunar | martian",
   "meaning": "Gravity level of the test"
  },
  "heating_ratio": {
   "kind": "condition",
   "unit": "ratio",
   "meaning": "SAME heater resistance ratio Rt/R0 (interpretation unconfirmed)"
  },
  "aging_time_s": {
   "kind": "condition",
   "unit": "s",
   "meaning": "Time the smoke was aged before measurement"
  },
  "ignition_power_w": {
   "kind": "outcome",
   "unit": "W",
   "meaning": "Igniter power"
  },
  "ignition_time_s": {
